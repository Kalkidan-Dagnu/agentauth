# Google AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AgentAuth Server
AGENTAUTH_SECRET_KEY=your_secret_key_here_min_32_chars
AGENTAUTH_HOST=0.0.0.0
AGENTAUTH_PORT=8000
AGENTAUTH_DEBUG=false

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
AGENT_TOKEN_EXPIRE_HOURS=24

# Optional: Use Gemma (on-device) instead of Gemini (cloud)
# Set to "gemma" for offline/air-gapped environments
REASONING_BACKEND=gemini
