# ── Google AI ──────────────────────────────────────────────────────────────────
# Get your key at https://ai.google.dev (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentauth

# SQLite alternative for local development (no Postgres required)
# DATABASE_URL=sqlite+aiosqlite:///./agentauth.db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Secret used to sign agent identity tokens.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# ── AgentAuth Server ───────────────────────────────────────────────────────────
AGENTAUTH_HOST=0.0.0.0
AGENTAUTH_PORT=8000
AGENTAUTH_DEBUG=false

# ── Token settings ─────────────────────────────────────────────────────────────
# Default lifetime (hours) for issued agent JWT tokens
AGENT_TOKEN_EXPIRE_HOURS=24

# ── Optional: Reasoning backend ───────────────────────────────────────────────
# Set to "gemma" for offline/air-gapped environments (Gemma support coming soon)
REASONING_BACKEND=gemini
