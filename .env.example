# ── Google AI ──────────────────────────────────────────────────────────────────
# Get your key at https://ai.google.dev (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentauth

# SQLite alternative for local development (no Postgres required)
# DATABASE_URL=sqlite+aiosqlite:///./agentauth.db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Secret used to sign agent identity tokens.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# ── AgentAuth Server ───────────────────────────────────────────────────────────
AGENTAUTH_HOST=0.0.0.0
AGENTAUTH_PORT=8000
AGENTAUTH_DEBUG=false

# ── Token settings ─────────────────────────────────────────────────────────────
# Default lifetime (hours) for issued agent JWT tokens
AGENT_TOKEN_EXPIRE_HOURS=24

# ── Optional: Reasoning backend ───────────────────────────────────────────────
# gemini (default) — uses Google Gemini API, requires GEMINI_API_KEY
# gemma            — uses a local Gemma model, fully offline, no API key needed
REASONING_BACKEND=gemini

# ── Gemma backend (only used when REASONING_BACKEND=gemma) ────────────────────
# Install Gemma extras first: pip install "agentauth[gemma]"
#
# Option A: download from HuggingFace Hub on first run (requires HF_TOKEN
#           and accepting Google's licence at huggingface.co/google/gemma-3-1b-it)
# GEMMA_MODEL_ID=google/gemma-3-1b-it
#
# Option B: use weights already downloaded to a local directory
# GEMMA_MODEL_PATH=/path/to/gemma-3-1b-it
#
# HuggingFace token (required for HF Hub download, not needed for local path)
# HF_TOKEN=hf_your_token_here
#
# Enable 4-bit quantisation to halve RAM usage (requires bitsandbytes)
# GEMMA_LOAD_IN_4BIT=false
# GEMMA_LOAD_IN_8BIT=false
